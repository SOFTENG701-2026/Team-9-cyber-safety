{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:ts": "tsc -b",
    "build:web": "vite build",
    "build": "npm run build:ts && npm run build:web",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "validate:commit": "npx --no-install lint-staged && npm run build",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@dnd-kit/react": "^0.4.0",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "lint-staged": "^17.0.5",
    "postcss": "^8.5.14",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^3.4.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^8.0.12"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "cd frontend && npm run validate:commit"
  }
}
